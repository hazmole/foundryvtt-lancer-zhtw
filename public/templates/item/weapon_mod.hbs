<form class="{{cssClass}} lancer-sheet" autocomplete="off">
  {{! Sheet Header }}
  <header class="sheet-header card clipped-bot">
    <div class="flexrow">
      <div class="header-fields flexcol grow">
        <h1 class="charname">
          <input
            class="header-field"
            name="name"
            type="text"
            value="{{item.name}}"
            placeholder="{{localize 'lancer.glossary.name'}}"
          />
        </h1>
        {{{item-edit-license}}}
      </div>
      {{{ref-portrait-img item.img "img" item}}}
    </div>
  </header>

  {{! Sheet Body }}
  <section class="sheet-body flexrow sheet-weapon-mod">
    <div class="flexcol" style="flex-basis: 66%">
      {{{item-edit-effect "system.effect"}}}
      {{{item-edit-arrayed-actions "system.actions" (localize "lancer.glossary.added_actions")}}}
      {{{item-edit-arrayed-damage "system.added_damage" (localize "lancer.glossary.added_damage")}}}
      {{{item-edit-arrayed-range "system.added_range" (localize "lancer.glossary.added_range")}}}
      {{{item-edit-arrayed-tags "system.added_tags" (localize "lancer.glossary.added_tags")}}}
      {{{item-edit-arrayed-bonuses "system.bonuses"}}}
      <div class="flexrow">
        {{{counter-array system.counters "system.counters" true}}}
      </div>
      {{{item-edit-arrayed-deployables "system.deployables" (localize "lancer.glossary.added_deployables")}}}
      {{{item-edit-arrayed-synergies "system.synergies" (localize "lancer.glossary.synergies")}}}
      {{{item-edit-arrayed-integrated "system.integrated" (localize "lancer.glossary.integrated_items")}}}
      {{{item-edit-arrayed-tags "system.tags" (localize "lancer.glossary.tags")}}}
    </div>
    <div class="flexcol" style="flex-basis: 33%;">
      {{{item-edit-sp "system.sp"}}}
      {{#if (is-limited item)}}
        {{{limited-uses-indicator item "item"}}}
      {{/if}}
      {{{item-edit-checkboxes-object (localize "lancer.glossary.Allowed_Sizes") "system.allowed_sizes"}}}
      {{{item-edit-checkboxes-object (localize "lancer.glossary.Allowed_Types") "system.allowed_types"}}}
    </div>
  </section>
</form>