<form class="{{cssClass}} lancer-sheet" autocomplete="off">
  {{! Sheet Header }}
  <header class="sheet-header card clipped-bot">
    <div class="flexrow">
      <div class="header-fields">
        <h1 class="charname"><input
            class="header-field"
            name="name"
            type="text"
            value="{{item.name}}"
            placeholder="{{localize 'lancer.glossary.name'}}"
          /></h1>
      </div>
      {{{ref-portrait-img item.img "img" item}}}
    </div>
  </header>

  <div class="flexcol">
    {{! Status }}
    <div class="card clipped">
      <div class="lancer-header lancer-primary major">{{localize 'lancer.sheets.misc.pilot_item_status'}}</div>
      <div class="flexrow" style="align-self: center;">
        {{#if (is-limited item)}}
          {{{limited-uses-indicator item}}}
        {{/if}}
      </div>
    </div>

    {{{textarea-card (localize "lancer.glossary.description") "system.description"}}}

    {{! Bonuses }}
    {{!-- prettier-ignore --}}
    <div>
      {{{item-edit-arrayed-actions      "system.actions"      (localize "lancer.glossary.actions")}}}
      {{{item-edit-arrayed-bonuses      "system.bonuses"}}}
      {{{item-edit-arrayed-deployables  "system.deployables"  (localize "lancer.glossary.deployables")}}}
      {{{item-edit-arrayed-synergies    "system.synergies"    (localize "lancer.glossary.synergies")}}}
    </div>

    {{{item-edit-arrayed-tags "system.tags" (localize "lancer.glossary.tags")}}}
  </div>

</form>